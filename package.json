{
  "name": "simplistic-todolist",
  "description": "A beautiful, simplistic todo list app with priority-based task management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://github.com/KevOneRedOne/Simplistic-TodoList",
  "repository": {
    "type": "git",
    "url": "https://github.com/KevOneRedOne/Simplistic-TodoList.git"
  },
  "license": "MIT",
  "author": "KevOneRedOne",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "gh-pages -d dist --repo https://github.com/KevOneRedOne/Simplistic-TodoList.git",
    "preview": "vite preview",
    "prepare": "husky install",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "lint:fix": "eslint --fix",
    "lint": "eslint .",
    "dev:cache": "vite --force",
    "type:check": "npx tsc --project tsconfig.app.json --noEmit",
    "type:watch": "npx tsc --project tsconfig.app.json --noEmit --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "gh-pages": "^6.2.0",
    "globals": "^15.11.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.8"
  },
  "lint-staged": {
    "*.{js,css,ts,tsx,jsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
